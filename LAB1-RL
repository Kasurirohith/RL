      "source": [
        "n = int(input(\"Enter number of machines: \"))\n",
        "\n",
        "machines = []\n",
        "Q = []\n",
        "N = []\n",
        "\n",
        "# Input machine names and rewards\n",
        "for i in range(n):\n",
        "    name = input(\"Enter machine name: \")\n",
        "    rewards = list(map(int, input(\"Enter rewards: \").split()))\n",
        "\n",
        "    machines.append(name)\n",
        "    Q.append(0)\n",
        "    N.append(0)\n",
        "\n",
        "    # Incremental update\n",
        "    for R in rewards:\n",
        "        N[i] += 1\n",
        "        Q[i] = Q[i] + (R - Q[i]) / N[i]\n",
        "\n",
        "# Display final Q values\n",
        "print(\"\\nEstimated Q values:\")\n",
        "\n",
        "for i in range(n):\n",
        "    print(\"Machine\", machines[i])\n",
        "    print(\"Q =\", round(Q[i], 2))\n",
        "\n",
        "# Greedy selection\n",
        "best = 0\n",
        "\n",
        "for i in range(1, n):\n",
        "    if Q[i] > Q[best]:\n",
        "        best = i\n",
        "\n",
        "print(\"\\nGreedy Selected Machine:\", machines[best])"
      ]
